generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum AprStatus {
  RASCUNHO
  EM_ANDAMENTO
  ASSINADA
  CANCELADA
}

enum PtStatus {
  RASCUNHO
  EM_ANDAMENTO
  APROVADA
  ENCERRADA
  CANCELADA
}

model Company {
  id          String        @id @default(cuid())
  name        String
  cnpj        String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  users       User[]
  obras       Obra[]
  funcionarios Funcionario[]
  atividades  Atividade[]
  aprs        Apr[]
  pts         Pt[]
  assinaturas Assinatura[]
  auditLogs   AuditLog[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Obra {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome        String
  endereco    String
  responsavel String?
  aprs        Apr[]
  pts         Pt[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([companyId])
}

model Funcionario {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome        String
  cpf         String?
  cargo       String
  matricula   String?
  ativo       Boolean      @default(true)
  assinaturas Assinatura[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
}

model Atividade {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  riscos      String[]
  medidas     String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Apr {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  obraId      String
  obra        Obra         @relation(fields: [obraId], references: [id])
  titulo      String
  descricao   String
  riscos      Json
  medidas     Json
  status      AprStatus    @default(RASCUNHO)
  assinaturas Assinatura[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
  @@index([obraId])
}

model Pt {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  obraId      String
  obra        Obra         @relation(fields: [obraId], references: [id])
  titulo      String
  escopo      String
  validadeAte DateTime?
  controles   Json
  status      PtStatus     @default(RASCUNHO)
  assinaturas Assinatura[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([companyId])
  @@index([obraId])
}

model Assinatura {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  funcionarioId String
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id])
  aprId         String?
  apr           Apr?         @relation(fields: [aprId], references: [id])
  ptId          String?
  pt            Pt?          @relation(fields: [ptId], references: [id])
  assinaturaSvg String
  hash          String
  timestamp     DateTime
  createdAt     DateTime     @default(now())

  @@index([companyId])
  @@index([aprId])
  @@index([ptId])
}

model SyncEvent {
  id        String   @id @default(cuid())
  companyId String
  entity    String
  action    String
  payload   Json
  createdAt DateTime @default(now())

  @@index([companyId])
}

model AuditLog {
  id          String   @id @default(cuid())
  entidade    String
  entidadeId  String
  acao        String
  dadosAntes  Json?
  dadosDepois Json?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id])

  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, timestamp])
  @@index([entidade, entidadeId])
}
